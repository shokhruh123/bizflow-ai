# Optional: unlock REAL LLM parsing (OpenAI-compatible endpoint).
# If left empty, BizFlow AI runs fully offline with its built-in Smart Local AI engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: Gemini API key. If set, it takes priority over the OpenAI-compatible
# endpoint above and powers the AI Assistant (/app/assistant) and chat parsing.
# Never commit the real key — keep it in .env.local only.
GEMINI_API_KEY=